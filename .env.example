# Environment Variables Template
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to version control!

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/kms_db
DB_USERNAME=kms_user
DB_PASSWORD=change_this_password

# JWT Configuration
# Generate a secure secret with: openssl rand -base64 32
# Or PowerShell: $rng = [System.Security.Cryptography.RNGCryptoServiceProvider]::new(); $bytes = New-Object byte[] 32; $rng.GetBytes($bytes); [Convert]::ToBase64String($bytes)
JWT_SECRET=GENERATE_YOUR_OWN_SECURE_32_BYTE_BASE64_KEY_HERE
JWT_EXPIRATION=86400000
